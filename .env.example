# Copia este archivo a `.env` y completalo con tus valores.
# Para correr local: en Windows, antes de `gradlew bootRun`, exportá estas variables o cargalas de otra forma.

# Supabase (transaction pooler usa puerto 6543). URL en formato JDBC.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<password-de-la-db>

# Origenes permitidos por CORS (separados por coma). Incluye el frontend de produccion.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<tu-frontend>.com

# Secreto JWT en Base64 (>= 32 bytes). Generalo con: openssl rand -base64 48
JWT_SECRET_KEY=<clave-base64-de-32-o-mas-bytes>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Wikisource (historias clasicas). Son opcionales: tienen default en application.properties.
WIKISOURCE_API_BASE_URL=https://es.wikisource.org
WIKISOURCE_USER_AGENT=EcosDeHalloween/0.1
CLASSIC_CACHE_TTL=86400000
